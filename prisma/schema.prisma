generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GC
  SUBCONTRACTOR
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIAL_APPROVED
  REJECTED
}

enum ChangeOrderStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ComplianceDocType {
  COI
  LICENSE
  BOND
  WORKERS_COMP
  OTHER
}

enum ComplianceDocStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
}

enum PayrollStatus {
  PENDING
  SUBMITTED
  APPROVED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(SUBCONTRACTOR)
  companyName   String?
  licenseNumber String?
  phone         String?
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  gcProjects          Project[]            @relation("GCProjects")
  contracts           Contract[]
  comments            Comment[]
  notifications       Notification[]
  complianceDocuments ComplianceDocument[]
  certifiedPayrolls   CertifiedPayroll[]
  changeOrders        ChangeOrder[]
}

model Project {
  id             String        @id @default(cuid())
  name           String
  gcId           String
  contractNumber String?
  address        String?
  superintendent String?
  gcContact      String?
  gcEmail        String?
  startDate      DateTime?
  endDate        DateTime?
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  gc                User              @relation("GCProjects", fields: [gcId], references: [id])
  contracts         Contract[]
  certifiedPayrolls CertifiedPayroll[]
}

model Contract {
  id              String   @id @default(cuid())
  projectId       String
  subcontractorId String
  value           Float
  retainagePercent Float   @default(10)
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project              @relation(fields: [projectId], references: [id])
  subcontractor   User                 @relation(fields: [subcontractorId], references: [id])
  sovLineItems    SovLineItem[]
  applications    BillingApplication[]
  changeOrders    ChangeOrder[]
}

model SovLineItem {
  id             String   @id @default(cuid())
  contractId     String
  description    String
  scheduledValue Float
  isLocked       Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contract         Contract          @relation(fields: [contractId], references: [id])
  billingLineItems BillingLineItem[]

  @@map("SOVLineItem")
}

model BillingApplication {
  id                 String            @id @default(cuid())
  contractId         String
  periodMonth        Int
  periodYear         Int
  appNumber          Int
  status             ApplicationStatus @default(DRAFT)
  submittedAt        DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  signedAt           DateTime?
  signedByName       String?
  lienWaiverAccepted Boolean           @default(false)
  lienWaiverType     String?
  notes              String?
  gcComment          String?
  netDue             Float?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  contract  Contract          @relation(fields: [contractId], references: [id])
  lineItems BillingLineItem[]
  comments  Comment[]
}

model BillingLineItem {
  id                String   @id @default(cuid())
  applicationId     String
  sovLineItemId     String
  previousBilledPct Float    @default(0)
  thisPeriodPct     Float    @default(0)
  thisPeriodAmt     Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  application BillingApplication @relation(fields: [applicationId], references: [id])
  sovLineItem SovLineItem        @relation(fields: [sovLineItemId], references: [id])
}

model ChangeOrder {
  id              String            @id @default(cuid())
  contractId      String
  subcontractorId String
  coNumber        Int
  description     String
  amount          Float
  status          ChangeOrderStatus @default(PENDING)
  submittedAt     DateTime          @default(now())
  subSignedAt     DateTime?
  gcSignedAt      DateTime?
  gcComment       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  contract      Contract @relation(fields: [contractId], references: [id])
  subcontractor User     @relation(fields: [subcontractorId], references: [id])
}

model ComplianceDocument {
  id           String              @id @default(cuid())
  userId       String
  type         ComplianceDocType
  carrier      String?
  policyNumber String?
  expiryDate   DateTime
  fileUrl      String?
  status       ComplianceDocStatus @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model CertifiedPayroll {
  id            String        @id @default(cuid())
  projectId     String
  userId        String
  weekEnding    DateTime
  employeeCount Int           @default(0)
  totalWages    Float         @default(0)
  fileUrl       String?
  status        PayrollStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model Comment {
  id            String   @id @default(cuid())
  applicationId String
  userId        String
  message       String
  createdAt     DateTime @default(now())

  application BillingApplication @relation(fields: [applicationId], references: [id])
  user        User               @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
